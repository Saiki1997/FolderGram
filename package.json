{
  "name": "foldergram",
  "productName": "FolderGram",
  "version": "2.3.0",
  "description": "Upload folders of photos and videos to Telegram groups, sorted into topics and albums.",
  "main": "src/main.js",
  "author": "Saiki",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "app.foldergram",
    "productName": "FolderGram",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FolderGram-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "FolderGram-${version}-portable.exe"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "dependencies": {
    "ffmpeg-static": "5.2.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.17.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Saiki1997/FolderGram.git"
  },
  "homepage": "https://github.com/Saiki1997/FolderGram"
}
